{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "es5",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bakery/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@bakery/shared/types": ["libs/shared/types/src/index.ts"],
      "@bakery/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@bakery/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@bakery/shop/feature-cart": ["libs/bakery-shop/feature-cart/src/index.ts"],
      "@bakery/shop/feature-catalog": ["libs/bakery-shop/feature-catalog/src/index.ts"],
      "@bakery/management/feature-inventory": [
        "libs/bakery-management/feature-inventory/src/index.ts"
      ],
      "@bakery/management/feature-orders": ["libs/bakery-management/feature-orders/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
