{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "es5",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bakery/delivery/routing": ["libs/bakery-delivery-routing/src/index.ts"],
      "@bakery/delivery/tracking": [
        "libs/bakery-delivery-tracking/src/index.ts"
      ],
      "@bakery/management/feature-analytics": [
        "libs/bakery-management/feature-analytics/src/index.ts"
      ],
      "@bakery/management/feature-settings": [
        "libs/bakery-management/feature-settings/src/index.ts"
      ],
      "@bakery/shared/contexts": ["libs/shared/contexts/src/index.ts"],
      "@bakery/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@bakery/shared/data-mocks": ["libs/shared/data-mocks/src/index.ts"],
      "@bakery/shared/test-utils": ["libs/shared/test-utils/src/index.ts"],
      "@bakery/shared/types": ["libs/shared/types/src/index.ts"],
      "@bakery/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@bakery/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@bakery/shop/feature-cart": [
        "libs/bakery-shop/feature-cart/src/index.ts"
      ],
      "@bakery/shop/feature-catalog": [
        "libs/bakery-shop/feature-catalog/src/index.ts"
      ],
      "contexts": ["libs/shared/contexts/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "src-archive", "**/src-archive/**"]
}
