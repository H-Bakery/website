{
  "name": "delivery-tracking",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bakery-delivery-tracking/src",
  "projectType": "library",
  "tags": ["scope:delivery", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/bakery-delivery-tracking",
        "main": "libs/bakery-delivery-tracking/src/index.ts",
        "tsConfig": "libs/bakery-delivery-tracking/tsconfig.lib.json",
        "assets": ["libs/bakery-delivery-tracking/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/bakery-delivery-tracking/jest.config.ts"
      }
    }
  }
}
