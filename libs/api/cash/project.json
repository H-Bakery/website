{
  "name": "api-cash",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/cash/src",
  "projectType": "library",
  "tags": ["scope:api", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/cash",
        "tsConfig": "libs/api/cash/tsconfig.lib.json",
        "packageJson": "libs/api/cash/package.json",
        "main": "libs/api/cash/src/index.ts",
        "assets": ["libs/api/cash/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/api/cash/**/*.ts"]
      }
    }
  }
}
