{
  "name": "templates",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/templates/src",
  "projectType": "library",
  "tags": ["scope:api", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/templates",
        "main": "libs/api/templates/src/index.ts",
        "tsConfig": "libs/api/templates/tsconfig.lib.json",
        "assets": ["libs/api/templates/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/api/templates/jest.config.ts"
      }
    }
  }
}
