{
  "name": "api-import-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/import-service/src",
  "projectType": "library",
  "tags": ["scope:api", "type:service"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/import-service",
        "main": "libs/api/import-service/src/index.ts",
        "tsConfig": "libs/api/import-service/tsconfig.lib.json",
        "assets": ["libs/api/import-service/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/api/import-service/jest.config.ts"
      }
    }
  }
}
