{
  "name": "delivery-routing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bakery-delivery-routing/src",
  "projectType": "library",
  "tags": ["scope:delivery", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/bakery-delivery-routing",
        "main": "libs/bakery-delivery-routing/src/index.ts",
        "tsConfig": "libs/bakery-delivery-routing/tsconfig.lib.json",
        "assets": ["libs/bakery-delivery-routing/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/bakery-delivery-routing/jest.config.ts"
      }
    }
  }
}
