{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmitOnError": false,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@bakery/shared/types": ["../../../dist/libs/shared/types/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
