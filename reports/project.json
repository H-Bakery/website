{
  "name": "reports",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "reports",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project reports --web",
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "reports:build",
        "dev": true,
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "reports:build:production",
          "dev": false
        }
      }
    }
  }
}
