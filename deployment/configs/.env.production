# Bakery Production Environment Configuration
# Copy this file to apps/bakery-api/.env and customize for your deployment

# ===== APPLICATION SETTINGS =====
NODE_ENV=production
LOG_LEVEL=info

# ===== SERVER CONFIGURATION =====
# API Server
API_PORT=5000
API_HOST=localhost

# Frontend URLs
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_SHOP_URL=https://your-domain.com
NEXT_PUBLIC_MANAGEMENT_URL=https://your-domain.com/admin
NEXT_PUBLIC_LANDING_URL=https://your-domain.com/landing

# ===== DATABASE CONFIGURATION =====
# SQLite Database
DATABASE_URL=sqlite:/home/bakery/bakery/data/bakery.db
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=/home/bakery/bakery/data/bakery.db
DATABASE_LOGGING=false

# Database pool settings
DATABASE_POOL_MAX=5
DATABASE_POOL_MIN=1
DATABASE_POOL_ACQUIRE=30000
DATABASE_POOL_IDLE=10000

# ===== SECURITY SETTINGS =====
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-too
SESSION_COOKIE_MAX_AGE=86400000

# CORS Settings
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== EMAIL CONFIGURATION =====
# SMTP Settings (optional)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@your-domain.com

# ===== FILE UPLOAD SETTINGS =====
UPLOAD_DIR=/home/bakery/bakery/data/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# ===== LOGGING CONFIGURATION =====
LOG_DIR=/var/log/bakery
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_MAX_FILES=5

# ===== BACKUP SETTINGS =====
BACKUP_DIR=/home/bakery/bakery/backups
BACKUP_RETENTION_DAYS=30

# ===== WEBHOOK SETTINGS =====
# For order notifications, etc.
WEBHOOK_SECRET=your-webhook-secret-key

# ===== ANALYTICS =====
# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===== FEATURE FLAGS =====
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_DEBUG_LOGS=false

# ===== PAYMENT INTEGRATION =====
# Stripe (if using payment processing)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== CACHE CONFIGURATION =====
# Redis (if using cache - optional for Raspberry Pi)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ===== MONITORING =====
# Health check settings
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# ===== RASPBERRY PI SPECIFIC =====
# Memory limits
NODE_OPTIONS=--max-old-space-size=512

# Temperature monitoring (Raspberry Pi specific)
TEMP_WARNING_THRESHOLD=70
TEMP_CRITICAL_THRESHOLD=80

# ===== DEVELOPMENT OVERRIDES =====
# These should be false/disabled in production
DEBUG=false
DEVELOPMENT_MODE=false
HOT_RELOAD=false

# ===== CUSTOM BAKERY SETTINGS =====
# Business-specific configuration
BUSINESS_NAME="Your Bakery Name"
BUSINESS_ADDRESS="Your Address"
BUSINESS_PHONE="+1234567890"
BUSINESS_EMAIL="info@your-domain.com"

# Operating hours
OPENING_HOURS="Monday-Friday: 7:00-18:00, Saturday: 7:00-16:00, Sunday: Closed"

# Order settings
DEFAULT_ORDER_LEAD_TIME=24
MAX_ORDER_QUANTITY=100
ENABLE_ONLINE_ORDERS=true
ENABLE_PICKUP_ORDERS=true
ENABLE_DELIVERY_ORDERS=false

# Inventory settings
LOW_STOCK_THRESHOLD=10
AUTO_REORDER_ENABLED=false

# ===== SECURITY NOTES =====
# IMPORTANT: Change all secret keys before deploying to production!
# Use strong, randomly generated keys for:
# - JWT_SECRET
# - SESSION_SECRET
# - WEBHOOK_SECRET
# 
# Generate secure keys with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"