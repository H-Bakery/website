# Docker Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_DB=bakery_db
POSTGRES_USER=bakery_user
POSTGRES_PASSWORD=bakery_password
DATABASE_URL=postgresql://bakery_user:bakery_password@postgres:5432/bakery_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application Configuration
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRY=7d

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_LANDING_URL=http://localhost:4200
NEXT_PUBLIC_SHOP_URL=http://shop.localhost
NEXT_PUBLIC_MANAGEMENT_URL=http://manage.localhost

# CORS Configuration
CORS_ORIGIN=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost,http://shop.localhost,http://manage.localhost

# Email Configuration (using Mailhog in development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bakery.local

# WhatsApp Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=491706133279

# Phone Configuration
NEXT_PUBLIC_PHONE_NUMBER="+49 170 6133279"
NEXT_PUBLIC_STORE_PHONE="+49 6841 2229"

# Email Addresses
NEXT_PUBLIC_CONTACT_EMAIL="bestellung@baeckerei-heusser.de"
NEXT_PUBLIC_STORE_EMAIL="info@baeckerei-heusser.de"

# Monitoring Configuration (optional)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# pgAdmin Configuration (optional)
PGADMIN_DEFAULT_EMAIL=admin@bakery.local
PGADMIN_DEFAULT_PASSWORD=admin

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Logging
LOG_LEVEL=debug

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Session Configuration
SESSION_SECRET=your_session_secret_here_change_in_production
SESSION_MAX_AGE=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Development Tools
DEBUG=bakery:*