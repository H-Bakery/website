    "exceljs": "^4.4.0",
    "express-validator": "^7.2.1",
    "feed-reader": "^6.0.2",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "marked": "^16.1.2",
    "next": "^16.1.6",
    "next-seo": "^5.5.0",
    "next-transpile-modules": "^10.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "puppeteer": "^24.15.0",
    "qrcode.react": "^3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-open-weather": "^1.3.0",
    "react-query": "^3.39.3",
    "react-slideshow-image": "^4.0.4",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "umzug": "^3.8.2",
    "uuid": "^11.1.0"
