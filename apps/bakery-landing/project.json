{
  "name": "bakery-landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-landing",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project bakery-landing --web",
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "bakery-landing:build",
        "dev": true,
        "port": 3000,
        "hostname": "0.0.0.0"
      },
      "configurations": {
        "development": {
          "buildTarget": "bakery-landing:build:development"
        },
        "production": {
          "buildTarget": "bakery-landing:build:production",
          "dev": false
        }
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{projectRoot}/.next"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/bakery-landing"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "outputHashing": "none",
          "sourceMap": true,
          "extractCss": true
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/bakery-landing/src/environments/environment.ts",
              "with": "apps/bakery-landing/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "extractCss": true,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bakery-landing/jest.config.ts"
      }
    },
    "build-static": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-landing",
        "command": "NODE_ENV=production npx next build"
      },
      "outputs": ["{projectRoot}/out"],
      "metadata": {
        "description": "Build landing page for static deployment using Next.js static export",
        "help": {
          "command": "nx build-static bakery-landing",
          "example": "Build landing page with static export configured in next.config.js"
        }
      }
    },
    "build-static-standalone": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-landing",
        "command": "npx next build"
      },
      "outputs": ["{projectRoot}/out"],
      "metadata": {
        "description": "Standalone static build without shared library dependencies",
        "help": {
          "command": "nx build-static-standalone bakery-landing",
          "example": "Build landing page for static deployment"
        }
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-landing",
        "command": "npx http-server out -p 3001 -o"
      },
      "metadata": {
        "description": "Serve the static build output for testing",
        "help": {
          "command": "nx serve-static bakery-landing",
          "example": "Serve static files from out/ directory on port 3001"
        }
      }
    }
  }
}
