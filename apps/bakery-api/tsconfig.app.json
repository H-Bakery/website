{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@bakery/api/core": ["../../libs/api/core/src/index.ts"],
      "@bakery/api/orders": ["../../libs/api/orders/src/index.ts"],
      "@bakery/api/inventory": ["../../libs/api/inventory/src/index.ts"],
      "@bakery/api/customers": ["../../libs/api/customers/src/index.ts"],
      "@bakery/api/production": ["../../libs/api/production/src/index.ts"],
      "@bakery/api/notifications": ["../../libs/api/notifications/src/index.ts"]
