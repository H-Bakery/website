{
  "name": "bakery-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bakery-api/src",
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/migrations/*.js",
        "{projectRoot}/build.mjs",
        "{projectRoot}/tsconfig.bundle.json",
        "{workspaceRoot}/libs/api/**/*.ts",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/apps/bakery-api/bundle"],
      "options": {
        "command": "node apps/bakery-api/build.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/bakery-api/tsconfig.bundle.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck", "bundle"],
      "options": {
        "command": "node -e \"require('fs').accessSync('dist/apps/bakery-api/bundle/main.js')\""
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "command": "node --enable-source-maps dist/apps/bakery-api/bundle/main.js"
      }
    },
    "serve-legacy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node index.js",
        "cwd": "apps/bakery-api"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/bakery-api/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
