{
  "name": "bakery-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bakery-api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "bakery-api:build",
        "command": "node dist/apps/bakery-api/src/main.js"
      }
    },
    "serve-simple": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "bakery-api:build",
        "command": "node dist/apps/bakery-api/src/main-simple.js"
      }
    },
    "serve-legacy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node index.js",
        "cwd": "apps/bakery-api"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build"],
      "options": {
        "outputPath": "dist/apps/bakery-api",
        "main": "apps/bakery-api/src/main.ts",
        "tsConfig": "apps/bakery-api/tsconfig.build.json",
        "assets": [
          "apps/bakery-api/bakery",
          "apps/bakery-api/content",
          "apps/bakery-api/templates"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/bakery-api/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
