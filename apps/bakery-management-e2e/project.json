{
  "name": "bakery-management-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-management-e2e/src",
  "projectType": "application",
  "tags": ["type:e2e"],
  "implicitDependencies": ["bakery-management"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/bakery-management-e2e"
      ],
      "options": {
        "config": "apps/bakery-management-e2e/playwright.config.ts"
      }
    },
    "e2e-ci": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/bakery-management-e2e"
      ],
      "options": {
        "config": "apps/bakery-management-e2e/playwright.config.ts",
        "skipServe": true
      }
    }
  }
}
