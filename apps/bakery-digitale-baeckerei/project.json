{
  "name": "bakery-digitale-baeckerei",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-digitale-baeckerei",
  "projectType": "application",
  "tags": ["scope:digitale-baeckerei", "type:app"],
  "targets": {
    "sync-model": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/bakery-digitale-baeckerei",
        "command": "node scripts/sync-model.mjs"
      },
      "metadata": {
        "description": "Downloads twin.glb and catalogue.json at the commit pinned in model.lock.json into public/model/ (git-ignored), verifies sha256, aborts on a mismatch. No download when the files are already there."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-model"],
      "outputs": ["{projectRoot}/out"],
      "options": {
        "cwd": "apps/bakery-digitale-baeckerei",
        "command": "npx next build --webpack"
      },
      "metadata": {
        "description": "Static export to apps/bakery-digitale-baeckerei/out (webpack; Turbopack is unreliable in worktrees). DIGITALE_BAECKEREI_BASE_PATH=/digitale-baeckerei builds for the subpath."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-model"],
      "options": {
        "cwd": "apps/bakery-digitale-baeckerei",
        "command": "npx next dev --webpack -p 4222"
      },
      "metadata": {
        "description": "Development server on http://localhost:4222"
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-digitale-baeckerei",
        "command": "node ../../tools/e2e/serve-static.js out --port 4232"
      },
      "metadata": {
        "description": "Serves the static export (apps/bakery-digitale-baeckerei/out) on http://localhost:4232 - run the build first"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/bakery-digitale-baeckerei/**/*.{ts,tsx,js,jsx,mjs}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bakery-digitale-baeckerei/jest.config.ts"
      }
    }
  }
}
