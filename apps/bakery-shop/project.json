{
  "name": "bakery-shop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-shop",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project bakery-shop --web",
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "bakery-shop:build",
        "dev": true,
        "port": 4200,
        "hostname": "0.0.0.0"
      },
      "configurations": {
        "development": {
          "buildTarget": "bakery-shop:build:development"
        },
        "production": {
          "buildTarget": "bakery-shop:build:production",
          "dev": false
        }
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/bakery-shop"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/bakery-shop"
        },
        "production": {
          "outputPath": "dist/apps/bakery-shop"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bakery-shop/jest.config.ts"
      }
    }
  }
}
