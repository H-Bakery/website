{
  "name": "bakery-partybrezel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-partybrezel",
  "projectType": "application",
  "tags": ["scope:partybrezel", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/out"],
      "options": {
        "cwd": "apps/bakery-partybrezel",
        "command": "npx next build --webpack"
      },
      "metadata": {
        "description": "Static export to apps/bakery-partybrezel/out (webpack; Turbopack is unreliable in worktrees). PARTYBREZEL_BASE_PATH=/partybrezel builds for a subpath."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-partybrezel",
        "command": "npx next dev --webpack -p 4221"
      },
      "metadata": {
        "description": "Development server on http://localhost:4221"
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bakery-partybrezel",
        "command": "node ../../tools/e2e/serve-static.js out --port 4231"
      },
      "metadata": {
        "description": "Serves the static export (apps/bakery-partybrezel/out) on http://localhost:4231 - run the build first"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bakery-partybrezel/jest.config.ts"
      }
    }
  }
}
