{
  "name": "bakery-delivery",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-delivery",
  "projectType": "application",
  "tags": ["scope:delivery", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/bakery-delivery"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/bakery-delivery"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "bakery-delivery:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "bakery-delivery:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "bakery-delivery:build:production",
          "dev": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
