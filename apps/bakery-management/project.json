{
  "name": "bakery-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bakery-management",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project bakery-management --web",
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "bakery-management:build",
        "dev": true,
        "port": 4201
      },
      "configurations": {
        "development": {
          "buildTarget": "bakery-management:build:development"
        },
        "production": {
          "buildTarget": "bakery-management:build:production",
          "dev": false
        }
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/bakery-management"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/bakery-management"
        },
        "production": {
          "outputPath": "dist/apps/bakery-management"
        }
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/bakery-management/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bakery-management/jest.config.ts"
      }
    }
  }
}
