# Environment variables for apps/bakery-management
# Copy to .env.local and adjust as needed.

# Server-side only: base URL of the bakery API. Requests to /api/* are
# proxied (Next.js rewrite) to this host. Defaults to the local mock API.
# Auch src/proxy.ts fragt hier `GET /api/auth/me` mit dem Sitzungs-Cookie,
# bevor /admin/** und /backstube/** serverseitig rendern (F1). Gelesen zur
# Laufzeit, nicht beim Build.
API_URL=http://localhost:5000

# Exposed to the browser: URL of the customer shop, linked from the sidebar.
NEXT_PUBLIC_SHOP_URL=http://localhost:4200

# Pilotbetrieb (roadmap F2): 1 = nur die Pilot-Seiten (echte Daten) in der
# Navigation, Demo-Seiten sind gesperrt („Im Pilotbetrieb nicht verfügbar").
# Lokal aus, auf der Bäckerei-Box an (NEXT_PUBLIC_PILOT_MODE=1). Wird beim
# `next build` eingesetzt - auf der Box also schon beim Bauen setzen.
# Erlaubte Routen: src/lib/pilotMode.ts
NEXT_PUBLIC_PILOT_MODE=0

# Anmeldung (F1): Leerlauf-Abmeldung. An einer PIN-Station nach so vielen
# Minuten ohne Bedienung zurück zu den Namenskacheln (Vorgabe 10; spätestens
# 12 h nach der PIN endet die Stationssitzung ohnehin), persönliche Sitzungen
# nach so vielen Stunden (Vorgabe 12). Wird beim `next build` eingesetzt.
NEXT_PUBLIC_STATION_IDLE_MINUTES=10
NEXT_PUBLIC_IDLE_LOGOUT_HOURS=12
# Optional: Stationssitzungen enden zu dieser Uhrzeit (HH:MM, Ortszeit des
# Tablets), z. B. zum Ladenschluss. Leer = keine feste Uhrzeit.
# NEXT_PUBLIC_STATION_LOGOUT_AT=13:30

# Browser-seitige Basis-URL der API für den ApiClient (Bearer-Token,
# X-Station-Token). Ohne Wert: http://localhost:5000.
# NEXT_PUBLIC_API_URL=http://localhost:5000
