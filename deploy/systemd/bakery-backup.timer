# Backup jede Nacht um 23:30 - lange vor dem Backbeginn um 02:00.

[Unit]
Description=Bäckerei Heusser - Backup nachts 23:30

[Timer]
OnCalendar=*-*-* 23:30:00 Europe/Berlin
RandomizedDelaySec=5min
# War die Box um 23:30 aus, läuft das Backup nach dem Start nach.
Persistent=true

[Install]
WantedBy=timers.target
