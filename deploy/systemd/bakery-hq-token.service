# GitHub-App-Token für das private hq-Repo erneuern (Q3, statt PAT).
# Gestartet von bakery-hq-token.timer (beim Start + alle 30 min). Exit-Codes:
# siehe hq-token.sh. Log: journalctl -u bakery-hq-token (nie das Token).
#
# Läuft als root: nur root liest den privaten Schlüssel der App
# (/etc/bakery/github-app.pem, root:root 0600). Ergebnis ist
# /etc/bakery/hq-token (root:bakery 0640, 1 h gültig, nur hq), das die API,
# hq-sync.sh und der Vorbestellungs-Snapshot bei jeder Verwendung lesen.

[Unit]
Description=Bäckerei Heusser - GitHub-App-Token für hq erneuern
Documentation=https://github.com/H-Bakery/website/blob/main/docs/runbook.md
After=network-online.target
Wants=network-online.target
# Vor dem ersten hq-Sync bzw. Snapshot, wenn beide zugleich anstehen (Start).
# Bewusst nicht vor bakery-api: die API wartet nie auf GitHub - sie liest die
# Datei bei jeder Verwendung und versucht es alle 15 min erneut.
Before=bakery-hq-sync.service bakery-snapshot-preorders.service

[Service]
Type=oneshot
EnvironmentFile=/etc/bakery/bakery.env
EnvironmentFile=-/etc/bakery/ops.env
Environment=BAKERY_ENV_LOADED=1
ExecStart=/opt/bakery/bin/hq-token.sh
TimeoutStartSec=2min

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
# Nur hier wird geschrieben: Temp-Datei + rename auf /etc/bakery/hq-token.
ReadWritePaths=/etc/bakery
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# root ohne Sonderrechte, nur chown root:bakery der Token-Datei.
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
