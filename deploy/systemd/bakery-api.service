# Bäckerei-API (TypeScript, esbuild-Bundle aus B0) - roadmap §4, O1.
# Installiert von deploy/scripts/install.sh nach /etc/systemd/system/.
# Code: /opt/bakery/current (Symlink auf das aktive Release, deploy.sh).
# Daten: /var/lib/bakery (DB_PATH, hq-Klone). Logs: journalctl -u bakery-api

[Unit]
Description=Bäckerei Heusser - API (bakery-api)
Documentation=https://github.com/H-Bakery/website/blob/main/docs/runbook.md
After=network-online.target
Wants=network-online.target
# Nie aufgeben: health.sh meldet eine Dauerschleife, systemd soll weiter versuchen.
StartLimitIntervalSec=0

[Service]
Type=simple
User=bakery
Group=bakery
WorkingDirectory=/opt/bakery/current
EnvironmentFile=/etc/bakery/bakery.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/apps/bakery-api/bundle/main.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# --- Härtung (nichts davon bricht node; MemoryDenyWriteExecute bewusst NICHT,
#     V8 braucht ausführbaren JIT-Speicher) ---
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bakery
# Geheimnisse der Betriebs-Skripte (Telegram, restic, AWS, DNS-Token, GitHub-App-Schlüssel) sind ohnehin
# root:root 0600; hier zusätzlich unsichtbar, falls jemand die Rechte lockert.
InaccessiblePaths=-/etc/bakery/ops.env -/etc/bakery/restic-password -/etc/bakery/github-app.pem -/etc/caddy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
