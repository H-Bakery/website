# Optional für bakery-whisper.service. Nach /etc/bakery/whisper.env kopieren,
# wenn die Vorgaben geändert werden sollen. Anschließend den Dienst neu starten.
# Das Modell muss im schreibgeschützt eingebundenen Verzeichnis liegen.
WHISPER_MODEL=/var/lib/bakery/whisper/ggml-small-q5_1.bin
# Der Dienst lauscht nur auf 127.0.0.1. Bei anderem Port auch VOICE_STT_URL ändern.
WHISPER_PORT=8178
WHISPER_THREADS=3
# 0 lässt den Server das volle 30-Sekunden-Fenster nutzen. Die API setzt den
# Audiokontext standardmäßig pro Aufnahme. Für VOICE_STT_AUDIO_CTX=0 hier 0 lassen.
WHISPER_AUDIO_CTX=0
