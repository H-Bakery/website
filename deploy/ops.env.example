# /etc/bakery/ops.env - Geheimnisse und Einstellungen der Betriebs-Skripte
# (backup, health, deploy). Nicht für die API. Rechte root:root 0600: systemd
# liest die Datei als root (EnvironmentFile=) und reicht die Werte nur an
# bakery-backup/bakery-health weiter; der Benutzer bakery - und damit die API und
# jedes npm-Skript beim Build - kann sie nicht lesen. deploy.sh übernimmt
# daraus nur TELEGRAM_*, DEPLOY_*, KEEP_RELEASES und HEALTH_*.
# Format wie bakery.env (systemd + bash).

## Telegram-Alarm (O2). Eigener Bot über @BotFather empfohlen ("Bäckerei Box"),
## damit Alarme nicht an Annas Agenten hängen. CHAT_ID: Chat des Inhabers/Entwicklers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

## Off-site-Backup mit restic (O2, Q4)
# z. B. s3:https://rustfs.example.de/bakery-backup/box  oder  sftp:backup@host:/srv/restic/bakery
RESTIC_REPOSITORY=
# install.sh erzeugt die Datei (root:root 0600). Ihren Inhalt ZUSÄTZLICH im
# Passwort-Safe ablegen! Unter systemd kommt sie per LoadCredential= an backup.sh.
RESTIC_PASSWORD_FILE=/etc/bakery/restic-password
# Zugangsdaten für S3-kompatible Ziele (RustFS, MinIO, B2-S3, ...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
# 0, wenn der Zugang nur anhängen darf (empfohlen, runbook §5.2) - dann räumt der
# Entwickler mit vollen Rechten auf (restic forget --prune).
RESTIC_FORGET=1
BACKUP_HOST=bakery-box
# Zusätzliche Pfade fürs Off-site-Backup (Leerzeichen-getrennt), z. B. der
# Schreib-Klon mit noch nicht gepushten Stammdaten-Commits (offline, §4a).
BACKUP_EXTRA_PATHS=/var/lib/bakery/hq-write

## Health-Check (O2)
HEALTH_API_URL=http://127.0.0.1:5000/health
HEALTH_MGMT_URL=http://127.0.0.1:4201/
HEALTH_CHECKS="api management backup hq-sync disk tls"
# Host wie im Browser (intern.<domain>); leer = TLS-Prüfung übersprungen. Prüft
# HTTPS über Caddy und meldet, wenn das Zertifikat in < 14 Tagen abläuft.
HEALTH_TLS_HOST=
HEALTH_TLS_MIN_DAYS=14
BACKUP_MAX_AGE_HOURS=36
HQ_SYNC_MAX_AGE_MIN=90
DISK_MAX_PERCENT=90

## Deploy (O3)
BAKERY_REPO_URL=https://github.com/H-Bakery/website.git
# Branch/Tag, den deploy.sh ohne Argument baut.
DEPLOY_REF=main
KEEP_RELEASES=3
