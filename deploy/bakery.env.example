# /etc/bakery/bakery.env - Umgebung für bakery-api und bakery-management
# (roadmap §4, O1). install.sh legt die Datei aus dieser Vorlage an
# (root:bakery 0640) und erzeugt JWT_SECRET. Niemals ins Git.
#
# Die Datei lesen systemd (EnvironmentFile=) UND bash (deploy.sh, Ops-Skripte):
#   KEY=wert, keine Leerzeichen um "=", kein "export", keine $-Ausdrücke,
#   Werte mit Leerzeichen in "doppelte Anführungszeichen".
#
# Geheimnisse für Telegram und restic stehen absichtlich NICHT hier, sondern in
# /etc/bakery/ops.env (Vorlage ops.env.example, root:root 0600): die API braucht
# sie nicht, und wer die API übernimmt, soll nicht das Off-site-Backup löschen können.
#
# Die Domain steht hier in CORS_ORIGIN (und, nur wenn die API auf einer anderen
# Origin liegt, in NEXT_PUBLIC_API_URL). Solange einer der Werte noch "example."
# enthält, bricht deploy.sh ab und install.sh --check meldet es. Im LAN-HTTP-
# Betrieb (bis Q2, /etc/caddy/bakery.env BAKERY_LAN_HTTP=1) steht in CORS_ORIGIN
# die Adresse der Box, z. B. http://192.168.178.20 - eine Domain braucht es nicht.

## Laufzeit
NODE_ENV=production
TZ=Europe/Berlin
# Port der API. bakery-management bekommt --port 4201 im Unit-File.
PORT=5000
# Die API lauscht nur lokal (Caddy davor); server.ts übergibt HOST an listen().
HOST=127.0.0.1
LOG_LEVEL=info

## Datenbank (B0, B2)
DB_PATH=/var/lib/bakery/bakery.db
# Migrationen laufen bei jedem Start (B0: Umzug in-process, nicht abschaltbar).
# Wartezeit auf eine Schreibsperre in ms (B0-Vorgabe 5000) und SQL-Log (nur zur Fehlersuche):
# DB_BUSY_TIMEOUT_MS=5000
# DB_LOG_SQL=false

## Anmeldung (B3)
# Zufällig, mindestens 32 Zeichen, stabil über Neustarts (sonst sind alle
# Sitzungen weg). install.sh füllt den Wert, wenn er leer ist.
JWT_SECRET=
# Browser-Origin der Web-App. Die Verwaltung ruft die API seit F4 über die
# eigene Origin (/api hinter Caddy) - CORS spielt dann keine Rolle; der Wert
# schadet nicht und wird gebraucht, falls die API doch auf einer anderen Origin läuft.
# LAN-HTTP (bis Q2): http://<IP oder Name der Box>. Wechsel auf HTTPS: nur API neu starten.
CORS_ORIGIN=https://intern.example.de
# Wem die API X-Forwarded-For glaubt (Client-IP für das Login-Rate-Limit).
# Vorgabe "loopback" = Caddy auf derselben Box (auch im LAN-HTTP-Betrieb);
# "true" verweigert die API.
# TRUST_PROXY=loopback
# Konten: create-user-CLI (docs/runbook.md §3.9). Kein Standardkonto;
# BOOTSTRAP_ADMIN_USER/BOOTSTRAP_ADMIN_PASSWORD gelten nur außerhalb von Produktion.

## hq (D9, §4a)
# Lese-Klon auf main - nur hq-sync.sh aktualisiert ihn, niemand schreibt hinein.
HQ_DIR=/var/lib/bakery/hq
HQ_PRODUCTS_DIR=/var/lib/bakery/hq/products
HQ_REPORTS_DIR=/var/lib/bakery/hq/data/reports
HQ_FINANCE_DIR=/var/lib/bakery/hq/data/finance
# Backzettel-Stammdaten (Z3); Vorgabe ${HQ_DIR}/config/backzettel.yaml.
# HQ_BACKZETTEL_CONFIG=/var/lib/bakery/hq/config/backzettel.yaml
# Rezepte (/admin/rezepte); Vorgabe ${HQ_DIR}/data/recipes.
# HQ_RECIPES_DIR=/var/lib/bakery/hq/data/recipes
# Rezepte löschen/verschieben aus der Verwaltung. Erst auf 1 setzen, wenn die
# Pfadwache in hq (scripts/validate/check-paths.js) Löschungen unter
# data/recipes/** für app/edits erlaubt - sonst schlägt die rollende PR fehl
# und blockiert auch Produkt- und Grundmengen-Änderungen.
# HQ_RECIPES_ALLOW_DELETE=1
# Schreib-Klon für Stammdaten (B5/B5b: Worktree auf app/edits -> eine rollende PR).
# Ein eigener Klon, nie derselbe Pfad wie HQ_DIR (hq-sync.sh bricht sonst ab).
# install.sh legt ihn an (Markierung bakery.role=write-clone).
HQ_WRITE_DIR=/var/lib/bakery/hq-write
# Z9 (Snapshots nach data/production/** auf main): zweiter Worktree des Schreib-Klons
# auf main (install.sh: git -C $HQ_WRITE_DIR worktree add $HQ_SNAPSHOT_DIR main).
# Leer = keine Snapshots (Backzettel-Freigabe und Vorbestellungen bleiben nur in SQLite).
HQ_SNAPSHOT_DIR=/var/lib/bakery/hq-write-main
HQ_REPO_URL=https://github.com/H-Bakery/hq.git
HQ_BRANCH=main
# Zugang zu H-Bakery/hq (Contents + Pull requests), Q3. Benutzen hq-sync.sh
# (Lesen), install.sh (Klone) und die API (B5b: Push app/edits + PR, Z9: Push main).
# Normalfall seit 2026-11-08: GitHub-App. Root holt alle 30 min ein Token (1 h
# gültig, nur hq) nach HQ_GITHUB_TOKEN_FILE (bakery-hq-token.timer, hq-token.sh;
# App-ID und Schlüssel in ops.env); alle Nutzer lesen die Datei bei jeder Verwendung.
# Fehlt sie oder ist sie leer, verhält sich alles wie ohne Token: B5b aus,
# Produktänderungen bleiben als Commits auf der Box (GET /api/hq-sync/status sagt das).
HQ_GITHUB_TOKEN_FILE=/etc/bakery/hq-token
# Fester Token (fine-grained PAT) statt der App - gewinnt, wenn gesetzt. Ersatzweise
# (ohne beides) liest die API GITHUB_TOKEN.
HQ_GITHUB_TOKEN=
# Repository der rollenden PR (B5b) und REST-Basis-URL (nur für Tests ändern).
# HQ_GITHUB_REPO=H-Bakery/hq
# GITHUB_API_URL=https://api.github.com
# Abstand der Wiederholungsversuche für Push/PR und Snapshots in ms (Vorgabe 15 min).
# HQ_SYNC_RETRY_MS=900000

## Verwaltung (Next.js)
# NEXT_PUBLIC_* werden beim BUILD eingebacken - deploy.sh liest diese Datei vor
# `nx build`. Nach einer Änderung neu deployen (deploy.sh --rebuild).
# Leer lassen (F4): der Browser fragt /api auf derselben Origin; Caddy schickt
# /api/* an die API. Nur setzen, wenn die API unter einer anderen Adresse liegt.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PILOT_MODE=1
# Serverseitig, zur LAUFZEIT gelesen (kein Rebuild nötig): src/proxy.ts prüft
# damit Sitzungen (GET /api/auth/me) und reicht /api/* weiter, falls eine
# Anfrage doch bei Next landet (ohne Caddy, z. B. Port 4201 direkt).
API_URL=http://127.0.0.1:5000
NEXT_TELEMETRY_DISABLED=1

## Bewusst nicht gesetzt (im Pilot nicht gemountet oder Altlast, roadmap §3):
## EMAIL_*, SENDGRID_API_KEY, AWS_SES_*, REDIS_URL, DATABASE_URL, DB_HOST/DB_PORT/
## DB_NAME/DB_USER/DB_PASS/DB_DIALECT, DATABASE_PATH (alt, ersetzt durch DB_PATH),
## JAEGER_ENDPOINT, ENABLE_TRACING, ALERT_WEBHOOK_URL, ARCHIVAL_*, NOMINATIM_URL,
## OSRM_URL, GEOCODER_USER_AGENT (Touren, D11), MOCK_ADMIN_*/MOCK_STAFF_* (nur Mock-Server).
