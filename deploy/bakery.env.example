# /etc/bakery/bakery.env - Umgebung für bakery-api und bakery-management
# (roadmap §4, O1). install.sh legt die Datei aus dieser Vorlage an
# (root:bakery 0640) und erzeugt JWT_SECRET. Niemals ins Git.
#
# Die Datei lesen systemd (EnvironmentFile=) UND bash (deploy.sh, Ops-Skripte):
#   KEY=wert, keine Leerzeichen um "=", kein "export", keine $-Ausdrücke,
#   Werte mit Leerzeichen in "doppelte Anführungszeichen".
#
# Geheimnisse für Telegram und restic stehen absichtlich NICHT hier, sondern in
# /etc/bakery/ops.env (Vorlage ops.env.example, root:root 0600): die API braucht
# sie nicht, und wer die API übernimmt, soll nicht das Off-site-Backup löschen können.
#
# Die Domain steht hier zweimal (CORS_ORIGIN, NEXT_PUBLIC_API_URL). Solange einer
# der Werte noch "example." enthält, bricht deploy.sh ab und install.sh --check meldet es.

## Laufzeit
NODE_ENV=production
TZ=Europe/Berlin
# Port der API. bakery-management bekommt --port 4201 im Unit-File.
PORT=5000
# Die API soll nur lokal lauschen (Caddy davor). Wirkt erst, wenn main.ts/server.ts
# HOST beim listen() benutzt (Folgeaufgabe für B0); bis dahin schützt die Firewall.
HOST=127.0.0.1
LOG_LEVEL=info

## Datenbank (B0, B2)
DB_PATH=/var/lib/bakery/bakery.db
# Migrationen laufen bei jedem Start (B0: Umzug in-process, nicht abschaltbar).
# Wartezeit auf eine Schreibsperre in ms (B0-Vorgabe 5000) und SQL-Log (nur zur Fehlersuche):
# DB_BUSY_TIMEOUT_MS=5000
# DB_LOG_SQL=false

## Anmeldung (B3)
# Zufällig, mindestens 32 Zeichen, stabil über Neustarts (sonst sind alle
# Sitzungen weg). install.sh füllt den Wert, wenn er leer ist.
JWT_SECRET=
# Browser-Origin der Web-App (gleiche Origin wie die API hinter Caddy).
CORS_ORIGIN=https://intern.example.de

## hq (D9, §4a)
# Lese-Klon auf main - nur hq-sync.sh aktualisiert ihn, niemand schreibt hinein.
HQ_DIR=/var/lib/bakery/hq
HQ_PRODUCTS_DIR=/var/lib/bakery/hq/products
HQ_REPORTS_DIR=/var/lib/bakery/hq/data/reports
HQ_FINANCE_DIR=/var/lib/bakery/hq/data/finance
# Schreib-Klon für Stammdaten (B5/B5b: Worktree auf app/edits -> eine rollende PR).
# Ein eigener Klon, nie derselbe Pfad wie HQ_DIR (hq-sync.sh bricht sonst ab).
HQ_WRITE_DIR=/var/lib/bakery/hq-write
# Z9 (Snapshots nach data/production/**): zweiter Worktree auf main im Schreib-Klon.
# HQ_SNAPSHOT_DIR=/var/lib/bakery/hq-write-main
HQ_REPO_URL=https://github.com/H-Bakery/hq.git
HQ_BRANCH=main
# Fine-grained Token oder GitHub-App-Token für H-Bakery/hq (Contents + Pull requests), Q3.
# Benutzen hq-sync.sh (Lesen) und die API (B5b: Push + PR).
HQ_GITHUB_TOKEN=

## Verwaltung (Next.js)
# NEXT_PUBLIC_* werden beim BUILD eingebacken - deploy.sh liest diese Datei vor
# `nx build`. Nach einer Änderung neu deployen (deploy.sh --rebuild).
NEXT_PUBLIC_API_URL=https://intern.example.de
NEXT_PUBLIC_PILOT_MODE=1
# Serverseitiges Ziel des /api-Rewrites in apps/bakery-management/next.config.js.
API_URL=http://127.0.0.1:5000
NEXT_TELEMETRY_DISABLED=1

## Bewusst nicht gesetzt (im Pilot nicht gemountet oder Altlast, roadmap §3):
## EMAIL_*, SENDGRID_API_KEY, AWS_SES_*, REDIS_URL, DATABASE_URL, DB_HOST/DB_PORT/
## DB_NAME/DB_USER/DB_PASS/DB_DIALECT, DATABASE_PATH (alt, ersetzt durch DB_PATH),
## JAEGER_ENDPOINT, ENABLE_TRACING, ALERT_WEBHOOK_URL, ARCHIVAL_*, NOMINATIM_URL,
## OSRM_URL, GEOCODER_USER_AGENT (Touren, D11), MOCK_ADMIN_*/MOCK_STAFF_* (nur Mock-Server).
