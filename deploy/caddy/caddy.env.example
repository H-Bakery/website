# /etc/caddy/bakery.env - nur für Caddy (Rechte root:caddy 0640).
# Absichtlich getrennt von /etc/bakery/bakery.env: Caddy braucht den DNS-Token,
# aber nicht JWT_SECRET oder den hq-Token - und umgekehrt.

# LAN-HTTP bis zum Zertifikat (Q2, Entscheidung 2026-11-08): 1 = install.sh
# installiert Caddyfile.lan-http - die App unter http://<IP oder Name der Box>,
# ohne TLS, ohne DNS-Plugin. Gilt auch, solange BAKERY_DOMAIN der Platzhalter
# ist. Umstieg auf HTTPS: Domain + DNS-Token eintragen, 0 setzen, sudo
# install.sh, sudo systemctl restart caddy (docs/runbook.md §3.7).
BAKERY_LAN_HTTP=1

# Domain der Bäckerei; die Box ist unter intern.<BAKERY_DOMAIN> erreichbar (Q2).
BAKERY_DOMAIN=example.de
ACME_EMAIL=technik@example.de

# API-Token des DNS-Anbieters, der den _acme-challenge-TXT-Eintrag anlegt (Q2).
ACME_DNS_API_TOKEN=
# Nur bei CNAME-Delegation (STRATO -> deSEC): der Name, auf den der CNAME
# _acme-challenge.intern.<BAKERY_DOMAIN> zeigt, z. B.
# _acme-challenge.intern.baeckerei-box.dedyn.io
ACME_DNS_OVERRIDE=
